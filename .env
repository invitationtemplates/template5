# Public URL of the deployed site (used in WhatsApp / social link previews).
VITE_SITE_URL=https://your-invitation.example.com

# Optional: POST RSVP replies as JSON to this endpoint (Google Apps Script, Supabase function, etc.).
# Leave empty to send RSVP replies through WhatsApp instead.
VITE_RSVP_ENDPOINT=

# Optional: serve photos through Cloudinary (set a cloud name and give photos a cloudinaryId in the data file).
VITE_CLOUDINARY_CLOUD=
